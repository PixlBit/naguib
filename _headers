# Cloudflare Pages — HTTP headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src 'none'; media-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests

# Fingerprint-free static assets — cache hard for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The code, and NOT cached for a day.
#
# None of these filenames carry a hash, and the HTML that loads them always
# revalidates — so a day-long cache means a visitor can hold last week's
# stylesheet against today's markup. That is not theoretical: it blacked out
# the hero once (index.html asking a cached studio.js for a video id it did
# not have yet) and it drew the sound control as a raw white block (new
# sound.js, day-old studio.css with none of its styles).
#
# must-revalidate costs one conditional request per file per visit, answered
# 304 from the Cloudflare edge in a few milliseconds, and buys the guarantee
# that the markup, the styles and the behaviour a visitor gets are always the
# same deploy.
#
# Named one by one rather than by wildcard, so there is no question about
# which pattern won.
/studio.css
  Cache-Control: public, max-age=0, must-revalidate

/studio.js
  Cache-Control: public, max-age=0, must-revalidate

/chrome.js
  Cache-Control: public, max-age=0, must-revalidate

/project.css
  Cache-Control: public, max-age=0, must-revalidate

/project.js
  Cache-Control: public, max-age=0, must-revalidate

/notfound.css
  Cache-Control: public, max-age=0, must-revalidate

/notfound.js
  Cache-Control: public, max-age=0, must-revalidate

# the console's own two, for the same reason
/studio-admin.css
  Cache-Control: public, max-age=0, must-revalidate

/studio-admin.js
  Cache-Control: public, max-age=0, must-revalidate

# Tooling pages — never a search result, never cached
/studio-admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
